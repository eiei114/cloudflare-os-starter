{
  "name": "cloudflare-os-starter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "vp run -r --cache build",
    "test": "node --test 'scripts/**/*.test.ts' && pnpm --filter pi-runner test && pnpm --filter pi-daemon test && vp run --filter custom-gatekeeper --filter error-reporter --filter @gadgets/error-reporting --cache test",
    "types:scripts": "tsc -p scripts/tsconfig.json",
    "lint:check": "vp lint",
    "lint:fix": "vp lint --fix",
    "lint": "pnpm run lint:check && pnpm run types:scripts && pnpm run build",
    "check": "node scripts/deploy.ts --check",
    "deploy": "node scripts/deploy.ts"
  },
  "devDependencies": {
    "@gadgets/scripts": "workspace:*",
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@types/node": "26.1.0",
    "jsonc-parser": "^3.3.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
